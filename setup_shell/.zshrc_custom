export AWS_PROFILE=alcove-developer

## == Custom git branch autocomplete =
__git_branch_auto_complete() {
    compadd "${(@)${(f)$(git branch -a)}#??}"
}

# JJ prompt info (nearest bookmark + commits ahead + workspace)
_jj_prompt_info() {
  # Get nearest ancestor bookmark — use change_id for safe revset usage,
  # bookmarks for display (handles multiple bookmarks on same commit)
  local info
  # Prefer local bookmarks. "*" means origin does not have this bookmark at this commit (never pushed, or moved since).
  # Not synced(): that also compares against the @git pseudo-remote, which only the colocated default workspace
  # keeps current, so it shows a false "*" in added workspaces.
  # Fall back to remote_bookmarks() for remote-only case (e.g. main@origin with no local main).
  info=$(jj log --no-graph --ignore-working-copy \
    -r 'latest(::@ & bookmarks())' \
    --template 'change_id ++ "|" ++ local_bookmarks.map(|b| b.name() ++ if(remote_bookmarks.filter(|r| r.remote() == "origin" && r.name() == b.name()), "", "*")).join(" ")' \
    2>/dev/null)
  if [[ -z "$info" ]]; then
    info=$(jj log --no-graph --ignore-working-copy \
      -r 'latest(::@ & remote_bookmarks(remote=origin))' \
      --template 'change_id ++ "|" ++ remote_bookmarks.filter(|b| b.remote() == "origin").map(|b| b.name() ++ "@origin").join(" ")' \
      2>/dev/null)
  fi
  [[ -z "$info" ]] && return 1
  local bmark_id="${info%%|*}"
  local bookmark="${info#*|}"
  [[ -z "$bookmark" ]] && return 1

  local ahead
  ahead=$(jj log --no-graph --ignore-working-copy \
    -r "${bmark_id}..@" \
    --template '"x\n"' 2>/dev/null | wc -l | tr -d ' ')

  # Current workspace: the workspace(s) whose working-copy commit is @.
  # Normally exactly one. Shows several only if two workspaces were edited onto the same commit.
  local workspace
  workspace=$(jj log --no-graph --ignore-working-copy \
    -r '@' \
    --template 'working_copies.map(|w| w.name()).join(" ")' \
    2>/dev/null)

  local yellow=$'%{\e[38;5;227m%}'
  local dim=$'%{\e[38;5;243m%}'
  local reset=$'%{\e[0m%}'
  local out=""
  [[ -n "$workspace" ]] && out+="${dim}[${workspace}] "
  out+="${yellow}"$'\u2387 '"${bookmark}"

  if [[ $ahead -gt 0 ]]; then
    # Ambiguous if any parent of @ lies outside the bookmark's descendant lineage (merge from foreign branch)
    local stray
    stray=$(jj log --no-graph --ignore-working-copy \
      -r "parents(@) ~ ${bmark_id}::" \
      --template '"x\n"' 2>/dev/null | wc -l | tr -d ' ')
    if [[ $stray -gt 0 ]]; then
      out+=" ${dim}<many>"
    else
      out+=" ${dim}+${ahead}"
    fi
  fi

  out+="${reset}"
  echo "$out"
}

precmd() {
  JJ_PROMPT=$(_jj_prompt_info)
}
setopt promptsubst

